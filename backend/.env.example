FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Do not enable debug mode when FLASK_HOST is reachable from other devices:
# the Werkzeug debugger allows remote code execution to anyone on the network.
FLASK_DEBUG=False
# Who may register/delete files (and use the native file picker): "local"
# allows only requests originating from this PC, "off" disables it for
# everyone, "all" allows it from any device that can reach the API.
WRITE_MODE=local
